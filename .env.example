# OLLAMA_URL: URL of your local Ollama instance (default: http://localhost:11434)
OLLAMA_URL="http://localhost:11434"

# OLLAMA_MODEL: Open-weight model to use with Ollama (default: qwen3:4b, Apache 2.0)
OLLAMA_MODEL="qwen3:4b"

# PORT: Server port (default: 3000)
PORT="3000"

# BODY_LIMIT: Max JSON request body size accepted on /api (default: 100kb)
BODY_LIMIT="100kb"

# RATE_LIMIT_MAX: Max /api requests per IP per window (default: 60; 0 disables)
RATE_LIMIT_MAX="60"

# RATE_LIMIT_WINDOW_MS: Rate limit window in milliseconds (default: 60000)
RATE_LIMIT_WINDOW_MS="60000"

# AI_QUEUE_MAX: Extra AI requests allowed to wait while one generation runs (default: 5)
AI_QUEUE_MAX="5"

# CORS_ORIGINS: Comma-separated extra origins allowed to call /api.
# Same-origin, localhost, and private LAN origins are always allowed.
CORS_ORIGINS=""
